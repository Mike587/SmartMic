# Exploratory / test / scratch scripts — kept locally, never pushed.
sandbox/

# Personal notes — kept locally, never pushed.
mike-notes/

# Local generated code map — regenerate as needed, not shared.
overview.md

# Handover notes — kept locally, not shared.
HANDOVER.md

# Local-only projects — kept locally, never pushed.
projects/HD_Nuclei_from_slide/
projects/Marc_SM/

# Pixi — installed environments are regenerated from pixi.toml + pixi.lock
# (both of which ARE tracked). Never commit the multi-GB env tree.
.pixi/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ZEN API connection config — machine-specific and contains a control-token.
# Copy config.ini.example -> config.ini and fill in your own values.
config.ini

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Data / acquisition outputs (kept on F: drive, never in the repo)
*.czi
*.czexp
*.czexp.backup
*.png

# ...but DO track the experiment + position .czexp copies the smartmic_poc
# pipeline runs BY PATH.  These are vendored on purpose so the run is
# self-contained from a clone (see MS_SmartMic_PoC.py).
!projects/smartmic_poc/base_experiments/*.czexp
!projects/smartmic_poc/position_files/*.czexp
*.log
logs/
log/
output/
temp_*.py

# ...but the test fixtures ARE part of the repo — override the blanket *.czi /
# *.czexp ignores above so they get committed (reproducible tests).
!tests/fixtures/czexp/*.czexp
!tests/fixtures/czi/*.czi
# ...except the superseded large CZIs — use the *_small variants instead.
tests/fixtures/czi/sharp.czi
tests/fixtures/czi/blurry.czi
